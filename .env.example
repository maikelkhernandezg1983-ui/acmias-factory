# Clave de la API de Claude para "Importar menú desde una foto".
# Cargala en Vercel → Settings → Environment Variables. Nunca la subas al repositorio.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Acceso al portal del vendedor. Se arman en /ingresar/generar (la contraseña no sale del navegador).
# Un vendedor por entrada, separados por punto y coma: usuario=pbkdf2$...;otro=pbkdf2$...
VENDEDORES=
# Texto aleatorio largo (48+ caracteres) para firmar la sesión. También lo da /ingresar/generar.
SESION_SECRETO=

# Base de datos Neon (la carga sola la integración de Vercel)
DATABASE_URL=
# Orígenes que pueden enviar registros (la landing), separados por coma
LANDING_ORIGENES=

# Avisos de "Agenda tu demo" (opcionales: sin ellos la solicitud se guarda igual).
# Mail con Resend (resend.com). Creá la cuenta con el mail que recibe los avisos.
RESEND_API_KEY=
# Mail que recibe los avisos (por defecto acmias2026@gmail.com)
AVISO_EMAIL=
# Remitente; cuando el dominio esté verificado en Resend, por ejemplo: ACMIAS <avisos@acmias.com>
AVISO_EMAIL_DESDE=
# WhatsApp con CallMeBot: número:clave separados por punto y coma. Cada celular saca su clave una vez.
# Ejemplo: 5491135726247:123456;5491122541737:654321
AVISO_WHATSAPP=

# Avisos de "Agenda tu demo" (opcionales: sin ellos la solicitud se guarda igual).
# Mail con Resend (resend.com). Creá la cuenta con el mail que recibe los avisos.
RESEND_API_KEY=
# Mail que recibe los avisos (por defecto acmias2026@gmail.com)
AVISO_EMAIL=
# Remitente; cuando el dominio esté verificado en Resend, por ejemplo: ACMIAS <avisos@acmias.com>
AVISO_EMAIL_DESDE=
# WhatsApp con CallMeBot: número:clave separados por punto y coma. Cada celular saca su clave una vez.
# Ejemplo: 5491135726247:123456;5491122541737:654321
AVISO_WHATSAPP=
